# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Neon Postgres — used by the public order form (/pesan), the public status
# lookup (/status), and the admin panel (/[token]). This ALSO needs to be
# set in Vercel → Environment Variables, because all of those routes run in
# production (see src/lib/db.ts).
DATABASE_URL=

# R2 credentials are ALSO needed in production now — the public order form
# uploads customer photos directly (see src/app/pesan/actions.ts).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional overrides.
# R2_BUCKET_NAME=webbinaja-assets

# Public hostname assets are served from — the R2 bucket's "r2.dev subdomain"
# (Cloudflare dashboard → R2 → bucket → Settings → Public Access), e.g.
# "pub-xxxxxxxxxxxx.r2.dev", NO protocol/https:// prefix. Read by both
# src/lib/assets.ts (URL building) and next.config.ts (CSP + next/image
# allowlist) — must be set in Vercel too, or asset URLs/images break.
ASSET_CDN_DOMAIN=
# R2_CDN_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Admin panel (src/app/[token]) — the URL segment itself is the first
# secret gate; 404s if any of ADMIN_TOKEN/ADMIN_SESSION_SECRET are unset.
# Generate your own random values, don't reuse these placeholders:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_TOKEN=
ADMIN_SESSION_SECRET=

# Bootstrap credentials for the FIRST super admin account only — consulted
# once, when the `admins` table is still empty (see loginAction in
# src/app/[token]/actions.ts). After that first login succeeds, these are
# never read again; all subsequent logins go through the `admins` table.
# Safe to leave set after bootstrapping, but you can also unset them once
# you've confirmed the real account works.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
