# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
# Only scripts/assets/cli.ts reads these. The Next.js app never does.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional overrides — defaults match production.
# R2_BUCKET_NAME=webbinaja-assets
# R2_CDN_BASE_URL=https://cdn.webbinaja.com

# Local-only admin UI (src/app/admin/[token]) — never available when
# NODE_ENV=production, and 404s if any of these three are unset. Generate
# your own random values, don't reuse these placeholders:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_TOKEN=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
